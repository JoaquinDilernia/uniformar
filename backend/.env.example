DATABASE_URL=postgres://postgres:postgres@localhost:5432/uniformar
# Origen(es) del frontend para CORS, separados por coma. Obligatorio en producción.
FRONTEND_URL=http://localhost:5173
JWT_SECRET=cambiar-por-un-string-largo-de-al-menos-32-caracteres
ADMIN_EMAIL=jdilernia99@gmail.com
ADMIN_INITIAL_PASSWORD=cambiar
# local (carpeta backend/.uploads) o s3 (Cloudflare R2)
STORAGE_DRIVER=local
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=uniformar
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Agente de pauta (opcional). El token de Meta necesita ads_management, instagram_basic e instagram_manage_insights.
# Para publicar desde el calendario en Instagram, además instagram_content_publish 
# Con storage local, IG descarga de links firmados de la API: PUBLIC_API_URL (en Railway sale solo de RAILWAY_PUBLIC_DOMAIN).
# PUBLIC_API_URL=https://uniformar-production.up.railway.app
META_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
# Para subir videos a R2 desde el navegador, el bucket necesita CORS con PUT desde FRONTEND_URL.
